PORT=4000
# Your MongoDB connection string (e.g. MongoDB Atlas). Leave empty for a temporary in-memory DB.
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string

# First Super Admin — created automatically on first start when the database has no users.
ADMIN_NAME=Your Name
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true to fill an empty database with demo teams, clients and tasks instead.
SEED_DEMO=false

# Optional: path to a local mongod binary for the in-memory DB
# MONGOMS_SYSTEM_BINARY=C:/mongobin/mongod.exe

# Gmail (Mail page). See the README for how to get these from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. It encrypts the saved Google access; do not change it later.
MAIL_TOKEN_KEY=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/mail/oauth/callback
# Where the website runs, for returning after connecting an inbox
CLIENT_URL=http://localhost:5173

# Daily Work. By default these collections use a second database on the Workflow cluster.
# Use distinct names in every preview. Set the optional URI to use separate credentials or a different cluster.
WORKFLOW_MONGODB_DB_NAME=
DAILY_WORK_DB_NAME=workflow_daily_work
DAILY_WORK_MONGODB_URI=
GOOGLE_SIGN_IN_CLIENT_ID=
DAILY_WORK_SLACK_TOKEN=
DAILY_WORK_SLACK_CHANNEL=
DAILY_WORK_SHIFT_REPORTS=false
DAILY_WORK_SLACK_REPORTS=false
# Sunday=0. All report times are IST.
DAILY_WORK_REPORT_DAYS=1,2,3,4,5
DAILY_WORK_WEEKLY_DAY=5
DAILY_WORK_WEEKLY_TIME=18:00
DAILY_WORK_INCOMPLETE_TIME=00:00
DAILY_WORK_HUBSTAFF_ORG=
DAILY_WORK_HUBSTAFF_TOKEN=
