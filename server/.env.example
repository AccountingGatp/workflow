PORT=4000
# Your MongoDB connection string (e.g. MongoDB Atlas). Leave empty for a temporary in-memory DB.
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string

# First Super Admin — created automatically on first start when the database has no users.
ADMIN_NAME=Your Name
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true to fill an empty database with demo teams, clients and tasks instead.
SEED_DEMO=false

# Optional: path to a local mongod binary for the in-memory DB
# MONGOMS_SYSTEM_BINARY=C:/mongobin/mongod.exe

# Gmail (Mail page). See the README for how to get these from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. It encrypts the saved Google access; do not change it later.
MAIL_TOKEN_KEY=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/mail/oauth/callback
# Where the website runs, for returning after connecting an inbox
CLIENT_URL=http://localhost:5173
